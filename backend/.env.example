# ------------------------------------------------------------------
# Credit Ventures API – environment variables
# On Hostinger: add these in hPanel → your Node.js app → Environment variables
# (or upload a file named .env next to package.json with these lines)
# ------------------------------------------------------------------
NODE_ENV=production
# Hostinger sets PORT automatically – keep this line only for local runs
PORT=5000

# MongoDB connection string (MongoDB Atlas: Database → Connect → Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/credit_ventures?retryWrites=true&w=majority

# Long random strings – generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=12h

# Admin panel URL(s) allowed to call the API, comma separated ( * = allow all )
CORS_ORIGINS=https://admin.yourdomain.com

# Where uploaded KYC documents are stored (default: ./uploads inside the app)
# UPLOAD_DIR=/home/USER/credit-ventures-uploads
MAX_UPLOAD_MB=8

# First super admin – created automatically on first start (change the password after login)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisPassword@123

# Optional: real SMS OTP (then set Login OTP mode = SMS in admin)
# SMS_PROVIDER=msg91
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=
# SMS_PROVIDER=2factor
# TWOFACTOR_API_KEY=
