NODE_ENV=production
PORT=5000

# MongoDB (local on the VPS or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/credit_ventures

# Generate long random strings:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=12h

# Comma separated list of allowed origins for the admin panel ( * = allow all )
CORS_ORIGINS=https://admin.yourdomain.com

# Upload storage (KYC docs are stored in UPLOAD_DIR/private and never served publicly)
UPLOAD_DIR=/var/www/credit-ventures/uploads
MAX_UPLOAD_MB=8

# First super admin (created automatically on first start if no admin exists)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@creditventures.in
ADMIN_PASSWORD=ChangeThisPassword@123
